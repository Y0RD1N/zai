{
  "name": "zai",
  "version": "0.2.0",
  "private": true,
  "description": "Un espacio para tus agentes, proyectos e ideas.",
  "author": {
    "name": "Yordi (Y0RD1N)",
    "email": "173011369+Y0RD1N@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "check": "tsc -b && node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/agents.cjs",
    "test": "playwright test",
    "test:desktop": "node scripts/test-desktop.mjs",
    "dist": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test:unit": "node --test tests/agents.test.cjs",
    "test:providers": "node scripts/probe-agents.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@fontsource-variable/inter": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.57.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "typescript": "^6.0.0",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "io.github.y0rd1n.zai",
    "productName": "Zai",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "homepage": "https://github.com/Y0RD1N/zai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Y0RD1N/zai.git"
  },
  "desktopName": "io.github.y0rd1n.zai.desktop"
}
